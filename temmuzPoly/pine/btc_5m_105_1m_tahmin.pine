//@version=6
indicator("5M 105 BTC — 1dk Tahmin", shorttitle="105 1dk", overlay=true, max_labels_count=500, max_lines_count=500)

// ── 105 parametreleri (btc_5m_105_algo.py ile aynı) ─────────────
int   MIN_CONSENSUS         = 2
int   MIN_CONSENSUS_UP_MR   = 3
float TREND_NEUTRAL_CROSS   = 0.06
float TREND_NEUTRAL_SLOPE   = 0.03
float CVD_THRESH            = 0.05
float OB_THRESH             = 0.10

bool  showLabels            = input.bool(true, "YUKARI/ASAGI etiketleri")
bool  showBg                = input.bool(true, "Arka plan rengi")
int   labelEvery            = input.int(1, "Her N dakikada bir etiket", minval=1, maxval=5)
bool  onlyConfirmed5m       = input.bool(false, "Yalnızca kapanmış 5m mum (repaint az)")

// ── 5 dakikalık seride 4 algo ───────────────────────────────────
f_a1() =>
    float rsi = ta.rsi(close, 14)
    [macdL, sigL, _] = ta.macd(close, 12, 26, 9)
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    int rsi_v = rsi < 40 ? 1 : rsi > 60 ? -1 : 0
    int macd_v = macdL > sigL ? 1 : macdL < sigL ? -1 : 0
    int ema_v = e20 > e50 ? 1 : -1
    int score = rsi_v + macd_v + ema_v
    score >= 2 ? 1 : score <= -2 ? -1 : 0

f_trend() =>
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    float cross = e20 - e50
    float slope = e20 - e20[3]
    float pct = cross / close * 100.0
    float slope_pct = slope / close * 100.0
    if math.abs(pct) < TREND_NEUTRAL_CROSS or math.abs(slope_pct) < TREND_NEUTRAL_SLOPE
        0
    else if cross > 0 and slope > 0
        1
    else if cross < 0 and slope < 0
        -1
    else
        0

f_mr() =>
    float rsi = ta.rsi(close, 14)
    float basis = ta.sma(close, 20)
    float dev = ta.stdev(close, 20)
    float upper = basis + 2.0 * dev
    float lower = basis - 2.0 * dev
    int rsi_v = rsi <= 35 ? 1 : rsi >= 65 ? -1 : 0
    int bb_v = close <= lower ? 1 : close >= upper ? -1 : 0
    int raw = rsi_v + bb_v
    raw > 0 ? 1 : raw < 0 ? -1 : 0

f_of_v2() =>
    float cvd = 0.0
    float ob_press = 0.0
    float total_vol = math.sum(volume, 20)
    for i = 0 to 19
        float v = volume[i]
        cvd += close[i] >= open[i] ? v : -v
        float rng = high[i] - low[i]
        float press = rng > 0 ? ((close[i] - low[i]) - (high[i] - close[i])) / rng : 0.0
        ob_press += press * v
    float cvd_r = total_vol > 0 ? cvd / total_vol : 0.0
    float ob_r = total_vol > 0 ? ob_press / total_vol : 0.0
    int cvd_v = cvd_r > CVD_THRESH ? 1 : cvd_r < -CVD_THRESH ? -1 : 0
    int ob_v = ob_r > OB_THRESH ? 1 : ob_r < -OB_THRESH ? -1 : 0
    if cvd_v == ob_v
        cvd_v
    else if ob_v != 0
        ob_v
    else if cvd_v != 0
        cvd_v
    else
        0

f_conf(int n) =>
    n == 2 ? 55 : n == 3 ? 62 : n >= 4 ? 70 : 50

// dir: 1=YUKARI, -1=ASAGI, 0=yok
f_signal_105() =>
    int v1 = f_a1()
    int v2 = f_trend()
    int v3 = f_mr()
    int v4 = f_of_v2()
    int up = (v1 > 0 ? 1 : 0) + (v2 > 0 ? 1 : 0) + (v3 > 0 ? 1 : 0) + (v4 > 0 ? 1 : 0)
    int dn = (v1 < 0 ? 1 : 0) + (v2 < 0 ? 1 : 0) + (v3 < 0 ? 1 : 0) + (v4 < 0 ? 1 : 0)
    int dir = 0
    int conf = 0
    if up >= MIN_CONSENSUS and up > dn
        if v3 < 0 and up < MIN_CONSENSUS_UP_MR
            dir := 0
            conf := 0
        else
            dir := 1
            conf := f_conf(up)
    else if dn >= MIN_CONSENSUS and dn > up
        dir := -1
        conf := f_conf(dn)
    [dir, conf, up, dn, v1, v2, v3, v4]

lookaheadMode = onlyConfirmed5m ? barmerge.lookahead_off : barmerge.lookahead_on
[dir5, conf5, up5, dn5, v1, v2, v3, v4] = request.security(
     syminfo.tickerid, "5", f_signal_105(),
     gaps=barmerge.gaps_off, lookahead=lookaheadMode)

// ── Görsel: EMA (grafik referansı) ─────────────────────────────
plot(ta.ema(close, 9),  "EMA9",  color=color.new(color.lime, 0), linewidth=1)
plot(ta.ema(close, 21), "EMA21", color=color.new(color.orange, 0), linewidth=1)
plot(ta.ema(close, 55), "EMA55", color=color.new(color.blue, 0), linewidth=1)

// ── 1 dakikada etiket ───────────────────────────────────────────
bool showBar = showLabels and (bar_index % labelEvery == 0)
bool isUp = dir5 == 1
bool isDn = dir5 == -1

if showBar and isUp
    label.new(
         bar_index, low,
         "YUKARI\n" + str.tostring(conf5) + "%",
         style=label.style_label_up,
         color=color.new(color.green, 10),
         textcolor=color.white,
         size=size.small,
         yloc=yloc.price)

if showBar and isDn
    label.new(
         bar_index, high,
         "ASAGI\n" + str.tostring(conf5) + "%",
         style=label.style_label_down,
         color=color.new(color.red, 10),
         textcolor=color.white,
         size=size.small,
         yloc=yloc.price)

bgcolor(showBg and isUp ? color.new(color.green, 92) : showBg and isDn ? color.new(color.red, 92) : na)

// ── Durum satırı ────────────────────────────────────────────────
var table hud = table.new(position.top_right, 1, 6, bgcolor=color.new(color.black, 15), border_width=1)
if barstate.islast
    string yon = isUp ? "YUKARI" : isDn ? "ASAGI" : "—"
    color yc = isUp ? color.green : isDn ? color.red : color.gray
    table.cell(hud, 0, 0, "5M 105", text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 1, yon + " " + (dir5 != 0 ? str.tostring(conf5) + "%" : ""), text_color=yc, text_size=size.normal)
    table.cell(hud, 0, 2, "Oy: " + str.tostring(up5) + "↑ " + str.tostring(dn5) + "↓", text_color=color.silver, text_size=size.tiny)
    table.cell(hud, 0, 3, "A1 " + str.tostring(v1) + " | Tr " + str.tostring(v2), text_color=color.silver, text_size=size.tiny)
    table.cell(hud, 0, 4, "MR " + str.tostring(v3) + " | OF " + str.tostring(v4), text_color=color.silver, text_size=size.tiny)
    table.cell(hud, 0, 5, onlyConfirmed5m ? "5m kapanmış" : "5m canlı", text_color=color.gray, text_size=size.tiny)

alertcondition(isUp,  title="105 YUKARI", message="5M 105: YUKARI sinyali")
alertcondition(isDn, title="105 ASAGI",  message="5M 105: ASAGI sinyali")
