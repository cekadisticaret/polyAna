//@version=5
indicator("MACD Pro (COIN 15m) v2.0 - Gaia Düzeltmeli", shorttitle="MACD Pro COIN 15m v2.0", overlay=false)

// ===== GİRDİLER =====
fastLen = input.int(8,  "Fast Length",       minval=1)   // 12 → 8  (daha hızlı sinyal)
slowLen = input.int(21, "Slow Length",       minval=1)   // 26 → 21 (daha hızlı sinyal)
sigLen  = input.int(5,  "Signal Smoothing",  minval=1)   // 9  → 5  (daha hızlı sinyal)
src     = input.source(close, "Source")

// Filtreler
rsiLen  = input.int(14,   "RSI Periyodu")
rsiMin  = input.float(52, "Min RSI (BULL onayı)", step=0.5)  // 55 → 52 (biraz gevşet, fırsat kaçırma)
dmiLen  = input.int(14,   "DMI/ADX Periyodu")
adxTh   = input.float(22, "ADX Eşiği", step=0.5)            // 18 → 22 (kripto gürültüsü için)
volLen  = input.int(20,   "Hacim Ortalama Periyodu")
volMult = input.float(1.5, "Hacim Çarpanı", step=0.1)       // ✅ değişmedi

showTable = input.bool(true, "Durum Tablosu")
showBg    = input.bool(true, "Arka Plan (Bull/Bear)")

// ===== HESAPLAMALAR =====
fastMA   = ta.ema(src, fastLen)
slowMA   = ta.ema(src, slowLen)
macdLine = fastMA - slowMA
signal   = ta.ema(macdLine, sigLen)
hist     = macdLine - signal

rsi     = ta.rsi(close, rsiLen)
[_, __, adx] = ta.dmi(dmiLen, dmiLen)
volAvg  = ta.sma(volume, volLen)
volSpike = volume > volAvg * volMult

macdBull      = macdLine > signal
macdCrossUp   = ta.crossover(macdLine, signal)
macdCrossDown = ta.crossunder(macdLine, signal)
macdBear      = macdLine < signal

// Filtreler OK (LONG için)
filtersOkLong  = (rsi > rsiMin) and (adx > adxTh) and volSpike
// Filtreler OK (SHORT için — RSI düşük tarafı)
filtersOkShort = (rsi < (100 - rsiMin)) and (adx > adxTh) and volSpike

// ===== GÖRSEL =====
histColor =
 hist >= 0 ? (hist[1] < hist ? color.new(color.green, 0) : color.new(color.lime, 30))
 : (hist[1] > hist ? color.new(color.red, 0) : color.new(color.maroon, 30))

plot(hist,     "Histogram", style=plot.style_columns, color=histColor, linewidth=2)
plot(macdLine, "MACD",      color=color.new(color.blue,   0), linewidth=2)
plot(signal,   "Signal",    color=color.new(color.orange, 0), linewidth=2)
hline(0, "Zero", color=color.new(color.gray, 50))

// BULL onay üçgeni
plotshape(macdCrossUp and filtersOkLong, title="BULL ONAY",
 style=shape.triangleup, location=location.bottom,
 color=color.new(color.yellow, 0), size=size.normal, text="BULL\nONAY")

// SHORT onay üçgeni (yeni eklendi)
plotshape(macdCrossDown and filtersOkShort, title="BEAR ONAY",
 style=shape.triangledown, location=location.top,
 color=color.new(color.fuchsia, 0), size=size.normal, text="BEAR\nONAY")

if showBg
    bgcolor(macdBull ? color.new(color.green, 95) : color.new(color.red, 95))

// ===== DURUM TABLOSU =====
var table t = table.new(position.top_right, 2, 5, border_width=1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "MACD",      text_color=color.white, bgcolor=color.new(color.purple, 50))
    table.cell(t, 1, 0, macdBull ? "BULL✅" : "BEAR❌",
     text_color=color.white,
     bgcolor=macdBull ? color.new(color.green, 30) : color.new(color.red, 30))

    table.cell(t, 0, 1, "RSI",       text_color=color.white, bgcolor=color.new(color.purple, 50))
    table.cell(t, 1, 1, str.tostring(rsi, "#.#"),
     text_color=color.white,
     bgcolor=rsi > rsiMin ? color.new(color.green, 30) : rsi < (100 - rsiMin) ? color.new(color.red, 30) : color.gray)

    table.cell(t, 0, 2, "ADX",       text_color=color.white, bgcolor=color.new(color.purple, 50))
    table.cell(t, 1, 2, str.tostring(adx, "#.#"),
     text_color=color.white,
     bgcolor=adx > adxTh ? color.new(color.green, 30) : color.gray)

    table.cell(t, 0, 3, "Vol Spike", text_color=color.white, bgcolor=color.new(color.purple, 50))
    table.cell(t, 1, 3, volSpike ? "EVET✅" : "HAYIR❌",
     text_color=color.white,
     bgcolor=volSpike ? color.new(color.green, 30) : color.gray)

    table.cell(t, 0, 4, "Yön",       text_color=color.white, bgcolor=color.new(color.purple, 50))
    table.cell(t, 1, 4, filtersOkLong ? "LONG🟢" : filtersOkShort ? "SHORT🔴" : "BEKLE⏳",
     text_color=color.white,
     bgcolor=filtersOkLong ? color.new(color.green, 30) : filtersOkShort ? color.new(color.red, 30) : color.gray)

// ===== UYARILAR =====
alertcondition(macdCrossUp,
 title="MACD Yukarı Kesişim",
 message="🟡 MACD yukarı kesti | RSI=" + str.tostring(rsi, "#.#") + " ADX=" + str.tostring(adx, "#.#") + " VolSpike=" + (volSpike ? "EVET" : "HAYIR"))

alertcondition(macdCrossDown,
 title="MACD Aşağı Kesişim",
 message="🔴 MACD aşağı kesti | RSI=" + str.tostring(rsi, "#.#") + " ADX=" + str.tostring(adx, "#.#"))

alertcondition(macdCrossUp and filtersOkLong,
 title="GÜÇLÜ MACD BULL (COIN 15m)",
 message="🚀 COIN LONG: MACD CrossUp + Tüm Filtreler ONAY ✅")

alertcondition(macdCrossDown and filtersOkShort,
 title="GÜÇLÜ MACD BEAR (COIN 15m)",
 message="🔻 COIN SHORT: MACD CrossDown + Tüm Filtreler ONAY ✅")
