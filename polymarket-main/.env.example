# Polymarket Analyzer - Ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env asla git'e eklenmemeli (gitignore'da).

# --- Telegram (bildirimler için zorunlu: BOT_TOKEN) ---
TELEGRAM_BOT_TOKEN=                   # @BotFather'dan alınır
# TELEGRAM_CHAT_ID=id1,id2           # İsteğe bağlı sabit alıcı(lar), virgülle; yoksa listener + DB aboneleri

# --- Polymarket CLOB (gerçek işlem — Polygon USDC.e + POL) ---
# Otomatik emir: false iken cron tahmin + Telegram devam eder, emir yok
POLYMARKET_BOT_ENABLED=true
POLYMARKET_TRADING_ENABLED=true
POLYMARKET_PRIVATE_KEY=               # EOA private key (0x...); boş bırakılırsa gerçek emir gönderilmez
# POLYMARKET_CHAIN_ID=137
# POLYMARKET_FUNDER=                  # Boşsa private key adresi kullanılır (proxy cüzdan için ayarlayın)
# POLYMARKET_SIGNATURE_TYPE=0         # 0=EOA; Polymarket.com hesabı için 1/2 dokümana bakın
# POLYMARKET_ORDER_USDC=5             # Hedef nominal (USDC); tüm emirler bu değere göre

# --- xAI Grok API (analiz için zorunlu) ---
XAI_API_KEY=                            # console.x.ai'dan API key
# XAI_MODEL=grok-4.20-beta-0309-reasoning  # varsayılan

# Cron: `open` her saat :10, `resolve` :15 — bkz. cron.example
# Gün özeti portföy satırları: POLYMARKET_PRIVATE_KEY (CLOB USDC) + Data API pozisyonları (funder adresi)
