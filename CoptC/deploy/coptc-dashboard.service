[Unit]
Description=CoptC dashboard (B1#05 + B1#03 MUM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/CoptC
EnvironmentFile=/opt/CoptC/.env
ExecStart=/usr/bin/python3 /opt/CoptC/web/dashboard.py
Restart=always
RestartSec=5
StandardOutput=append:/tmp/coptc_dashboard.log
StandardError=append:/tmp/coptc_dashboard.log

[Install]
WantedBy=multi-user.target
