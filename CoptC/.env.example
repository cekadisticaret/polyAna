# CoptC — kopyalayıp `.env` yap, gerçek değerleri gir.
# Bu dosya yoksa sistem sanal modda çalışır: sinyal üretir, defter tutar,
# Polymarket'e emir göndermez.

# ── Polymarket cüzdanı (gerçek PM işlemi için zorunlu) ──────────
POLY_PRIVATE_KEY=
POLY_FUNDER=

# Gerçek emir göndermeyi açan ana şalter.
# true bırakırsan hiçbir emir gitmez, sadece "DRY RUN" loglanır.
POLY_DRY_RUN=true

# ── Dashboard ───────────────────────────────────────────────────
# Parola tanımlamazsan panel korumasızdır, "Live aç" herkese açık olur ve
# para çekme tamamen kapalı kalır.
COPTC_PASSWORD=
COPTC_SECRET=
COPTC_PORT=5060

# ── Para çekme ──────────────────────────────────────────────────
# Panelden çekim yaparken istenen kod. Boş bırakırsan çekim çalışmaz.
# 5 kez yanlış girilirse 15 dk kilitlenir.
COPTC_WITHDRAW_CODE=

# Relayer anahtarları — polymarket.com/settings?tab=builder
# Bunlar olmadan gönderim yapılamaz (bakiye yine de görünür).
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# ── Telegram — varsayılan KAPALI ────────────────────────────────
# Tek ana şalter: "off" olduğu sürece 11 gönderim noktasının hiçbiri
# Telegram'a çıkmaz, token doldurulsa bile. Sistem normal çalışır,
# sadece bildirim göndermez.
COPTC_TELEGRAM=off

# Açmak istersen COPTC_TELEGRAM=on yap ve aşağıdakileri doldur.
# Ana projeyle AYNI kanalı kullanma — iki sistemin mesajları karışır.
# TELEGRAM_ANALIZ4_BOT_TOKEN=
# TELEGRAM_A2_BOT_TOKEN=
# TELEGRAM_PM_LIVE_CHAT_ID=
# TELEGRAM_POLY_TRADERS_CHAT_ID=
