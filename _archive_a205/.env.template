# A2#05 Mean Reversion — ortam değişkenleri
# Bu dosya .env olarak kopyalanır. ASLA git'e commit etme.

# ─── Polymarket cüzdan (ZORUNLU — live işlem, bakiye, redeem için) ───
# Cüzdanın özel anahtarı. Bunu yalnızca sen doldurabilirsin.
POLY_PRIVATE_KEY=
# İşlemlerin göründüğü proxy/funder adresi (0x...)
POLY_FUNDER=
# 0=EOA  1=Magic proxy  2=Gnosis/browser  3=deposit wallet (pUSD)
POLY_SIGNATURE_TYPE=3
# false = gerçek emir gönderilir, true = simülasyon
POLY_DRY_RUN=false

# ─── Redeem (kazanan pozisyonları nakde çevirme) ───
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# ─── Dashboard ───
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=
POLY2_DASHBOARD_HOST=0.0.0.0
POLY2_DASHBOARD_PORT=5080
# P&L yüzdesi bu başlangıç sermayesine göre hesaplanır
POLY_START_BALANCE=381.89

# ─── Telegram bildirimleri (opsiyonel) ───
TG_ENABLED=false
POLY2_TG_ENABLED=false
TELEGRAM_A2_BOT_TOKEN=
TELEGRAM_A2_CHAT_ID=
