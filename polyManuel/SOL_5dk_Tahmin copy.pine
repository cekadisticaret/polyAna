//@version=5
indicator("SOL Birlesik Sinyal v1", overlay=true, max_labels_count=500)

// ══════════════════════════════════════════
// AYARLAR
// ══════════════════════════════════════════

// --- 5dk Tahmin ---
rsi_period   = input.int(14,  "RSI Periyodu",          group="5dk Tahmin")
ema_fast     = input.int(9,   "EMA Hizli",              group="5dk Tahmin")
ema_mid      = input.int(21,  "EMA Orta",               group="5dk Tahmin")
ema_slow     = input.int(55,  "EMA Yavas",              group="5dk Tahmin")
mom_period   = input.int(5,   "Momentum Periyodu",      group="5dk Tahmin")
vol_period   = input.int(20,  "Hacim Ort. Periyodu",    group="5dk Tahmin")
show_labels      = input.bool(true,  "Etiket Goster",              group="5dk Tahmin")
label_min_score  = input.int(35,   "Min Skor (Etiket Goster)",   group="5dk Tahmin", minval=0, maxval=110)
label_on_change  = input.bool(true, "Sadece Yon Degisiminde",    group="5dk Tahmin")
show_table       = input.bool(true, "Tablo Goster",              group="5dk Tahmin")

// --- Guclu Al (RSI+Vol+EMA) ---
volMult      = input.float(1.5, "Hacim Carpani",        group="Guclu Al")
emaShort     = input.int(50,  "EMA Kisa",               group="Guclu Al")
emaLong      = input.int(200, "EMA Uzun",               group="Guclu Al")
adxThresh    = input.int(25,  "ADX Trend Esigi",        group="Guclu Al")
distThresh   = input.float(5.0,"Maks Mesafe % EMA200",  group="Guclu Al")
show_gc      = input.bool(true, "Golden Cross Etiket",  group="Guclu Al")
show_buy     = input.bool(true, "Guclu Al Etiket",      group="Guclu Al")

// ══════════════════════════════════════════
// HESAPLAMALAR — ORTAK
// ══════════════════════════════════════════
[macd_line, signal_line, hist] = ta.macd(close, 12, 26, 9)
macd_bull  = hist > 0
avg_vol    = ta.sma(volume, vol_period)
vol_ratio  = volume / avg_vol
vol_spike  = volume > avg_vol * volMult
rsi_val    = ta.rsi(close, rsi_period)
[diplus, diminus, adx_val] = ta.dmi(14, 14)

// EMA seti 1: Tahmin (9/21/55)
ema9  = ta.ema(close, ema_fast)
ema21 = ta.ema(close, ema_mid)
ema55 = ta.ema(close, ema_slow)

// EMA seti 2: Guclu Al (50/200)
ema50  = ta.ema(close, emaShort)
ema200 = ta.ema(close, emaLong)

// ══════════════════════════════════════════
// BÖLÜM 1 — 5dk PERİYOT SKORU
// ══════════════════════════════════════════
mom3    = close - close[3]
mom5    = close - close[mom_period]
mom_pct = (close - close[mom_period]) / close[mom_period] * 100

sc_rsi    = rsi_val < 45 ? 20 : rsi_val > 55 ? -20 : rsi_val < 50 ? 8 : -8
sc_ema    = (ema9 > ema21 and ema21 > ema55) ? 25 : (ema9 < ema21 and ema21 < ema55) ? -25 : ema9 > ema21 ? 10 : -10
sc_eprice = close > ema9 ? 10 : -10
sc_macd   = hist > 0 ? 20 : -20
sc_mom    = (mom3 > 0 and mom5 > 0) ? 20 : (mom3 < 0 and mom5 < 0) ? -20 : mom3 > 0 ? 8 : -8
sc_vol    = vol_ratio > 1.3 ? (mom3 > 0 ? 5 : -5) : 0
sc_adx    = adx_val > adxThresh ? (diplus > diminus ? 10 : -10) : 0

total_score = sc_rsi + sc_ema + sc_eprice + sc_macd + sc_mom + sc_vol + sc_adx

// 5dk periyot kilidi
is_period_start = (minute % 5 == 0) and (time != time[1] or barstate.isfirst)
var int  locked_score = 0
var bool locked_bull  = false
var int  period_bar   = 0

if is_period_start
    locked_score := total_score
    locked_bull  := total_score > 0
    period_bar   := 1
else
    period_bar   := math.min(period_bar + 1, 5)

decision_bull  = locked_bull
decision_score = math.abs(locked_score)

var bool prev_bull = false
dir_changed = is_period_start and (locked_bull != prev_bull)
if is_period_start
    prev_bull := locked_bull

// ══════════════════════════════════════════
// BÖLÜM 2 — GÜÇLÜ AL (RSI+Vol+EMA)
// ══════════════════════════════════════════
priceDist    = ((close - ema200) / ema200) * 100
isNotTooFar  = math.abs(priceDist) < distThresh
goldenCross  = ta.crossover(ema50, ema200)

buyCondition = (ta.crossover(rsi_val, 50) or (rsi_val > 55 and rsi_val > rsi_val[1])) and vol_spike and close > ema50 and adx_val > adxThresh and macd_bull and isNotTooFar
strongBuy    = buyCondition and rsi_val > 55 and volume > ta.highest(volume, 10)[1] * 1.2
isValidGC    = goldenCross and isNotTooFar and rsi_val < 70 and macd_bull
isRiskyGC    = goldenCross and (not isNotTooFar or rsi_val >= 70 or not macd_bull)

// ══════════════════════════════════════════
// GÖRSELLEŞTİRME
// ══════════════════════════════════════════

// Mum rengi: 5dk karar skoruna göre (barcolor ile asıl mum boyanır)
barcolor(decision_score >= label_min_score ? (decision_bull ? color.lime : color.red) : color.gray)

// EMA çizgileri
plot(ema9,   "EMA 9",   color=color.new(color.lime,   30), linewidth=1)
plot(ema21,  "EMA 21",  color=color.new(color.orange, 30), linewidth=1)
plot(ema55,  "EMA 55",  color=color.new(color.blue,   30), linewidth=1)
plot(ema50,  "EMA 50",  color=color.new(color.orange,  0), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.blue,    0), linewidth=2)

// Arka plan (5dk blok)
bgcolor(decision_bull ? color.new(color.teal, 93) : color.new(color.red, 93), title="Periyot Arka Plan")

// 5dk periyot başı etiketi
score_ok     = decision_score >= label_min_score
change_ok    = not label_on_change or dir_changed
if show_labels and is_period_start and score_ok and change_ok
    lbl_txt   = decision_bull ? "YUKARI " + str.tostring(decision_score) + "%" : "ASAGI " + str.tostring(decision_score) + "%"
    lbl_style = decision_bull ? label.style_label_up : label.style_label_down
    lbl_col   = decision_bull ? color.new(#00B8A0, 10) : color.new(#CC2244, 10)
    lbl_y     = decision_bull ? low * 0.9980 : high * 1.0020
    label.new(bar_index, lbl_y, lbl_txt, style=lbl_style, color=lbl_col, textcolor=color.white, size=size.normal)

// Güçlü Al etiketi
if show_buy and strongBuy
    label.new(bar_index, low * 0.9970, "GUCLU AL", style=label.style_label_up, color=color.new(color.blue, 10), textcolor=color.white, size=size.large)

// Golden Cross etiketleri
if show_gc and isValidGC
    label.new(bar_index, low * 0.9960, "GOLDEN CROSS", style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.normal)

if show_gc and isRiskyGC
    label.new(bar_index, high * 1.0030, "RISKLI KESISIM", style=label.style_label_down, color=color.new(color.orange, 10), textcolor=color.white, size=size.small)

// ══════════════════════════════════════════
// DURUM TABLOSU (birlesik)
// ══════════════════════════════════════════
if show_table and barstate.islast
    var table t = table.new(position.top_right, 3, 12, bgcolor=color.new(color.black, 65), border_color=color.new(color.gray, 50), border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)

    // Başlık
    table.cell(t, 0, 0, "INDIKTOR",  text_color=color.silver, text_size=size.small, bgcolor=color.new(color.black, 50))
    table.cell(t, 1, 0, "SINYAL",    text_color=color.silver, text_size=size.small, bgcolor=color.new(color.black, 50))
    table.cell(t, 2, 0, "DEGER",     text_color=color.silver, text_size=size.small, bgcolor=color.new(color.black, 50))

    // RSI
    rc = rsi_val > 55 ? color.teal : rsi_val < 45 ? color.red : color.gray
    table.cell(t, 0, 1, "RSI", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, rsi_val > 55 ? "YUKARI" : rsi_val < 45 ? "ASAGI" : "NOTR", text_color=rc, text_size=size.small)
    table.cell(t, 2, 1, str.tostring(math.round(rsi_val, 1)), text_color=rc, text_size=size.small)

    // ADX
    ac = adx_val > adxThresh ? color.teal : color.gray
    table.cell(t, 0, 2, "ADX", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, adx_val > adxThresh ? "TREND" : "ZAYIF", text_color=ac, text_size=size.small)
    table.cell(t, 2, 2, str.tostring(math.round(adx_val, 1)), text_color=ac, text_size=size.small)

    // MACD
    mc = macd_bull ? color.teal : color.red
    table.cell(t, 0, 3, "MACD", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, macd_bull ? "BULL" : "BEAR", text_color=mc, text_size=size.small)
    table.cell(t, 2, 3, str.tostring(math.round(hist, 4)), text_color=mc, text_size=size.small)

    // Hacim
    vc = vol_spike ? color.teal : color.gray
    table.cell(t, 0, 4, "Hacim Spike", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, vol_spike ? "EVET" : "HAYIR", text_color=vc, text_size=size.small)
    table.cell(t, 2, 4, str.tostring(math.round(vol_ratio, 2)) + "x", text_color=vc, text_size=size.small)

    // EMA Trend (9/21/55)
    et = (sc_ema + sc_eprice) > 0 ? color.teal : color.red
    table.cell(t, 0, 5, "EMA 9/21/55", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, (sc_ema + sc_eprice) > 0 ? "YUKARI" : "ASAGI", text_color=et, text_size=size.small)
    table.cell(t, 2, 5, str.tostring(math.abs(sc_ema + sc_eprice)), text_color=et, text_size=size.small)

    // EMA Uzaklık
    dc = isNotTooFar ? color.teal : color.red
    table.cell(t, 0, 6, "EMA200 Uzaklik", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, isNotTooFar ? "YAKIN" : "UZAK", text_color=dc, text_size=size.small)
    table.cell(t, 2, 6, str.tostring(math.round(priceDist, 2)) + "%", text_color=dc, text_size=size.small)

    // Golden Cross
    gc_col = isValidGC ? color.teal : color.gray
    table.cell(t, 0, 7, "Golden Cross", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7, isValidGC ? "AKTIF" : "YOK", text_color=gc_col, text_size=size.small)
    table.cell(t, 2, 7, goldenCross ? "EVET" : "-", text_color=gc_col, text_size=size.small)

    // Güçlü Al
    ba_col = strongBuy ? color.blue : color.gray
    table.cell(t, 0, 8, "Guclu Al", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 8, strongBuy ? "AKTIF" : "-", text_color=ba_col, text_size=size.small)
    table.cell(t, 2, 8, buyCondition ? "HAZIR" : "-", text_color=ba_col, text_size=size.small)

    // Periyot bilgisi
    table.cell(t, 0, 9, "Periyot", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 9, str.tostring(period_bar) + "/5 mum", text_color=color.silver, text_size=size.small)
    table.cell(t, 2, 9, str.tostring(locked_score), text_color=locked_bull ? color.teal : color.red, text_size=size.small)

    // Ayraç
    table.cell(t, 0, 10, "───────────", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 10, "───────────", text_color=color.gray, text_size=size.small)
    table.cell(t, 2, 10, "───────", text_color=color.gray, text_size=size.small)

    // ANA KARAR
    res_col = decision_bull ? color.new(#00B8A0, 20) : color.new(#CC2244, 20)
    res_txt = decision_bull ? "YUKARI " + str.tostring(decision_score) + "%" : "ASAGI " + str.tostring(decision_score) + "%"
    table.cell(t, 0, 11, "5dk KARAR", text_color=color.white, text_size=size.normal, bgcolor=res_col)
    table.cell(t, 1, 11, res_txt,      text_color=color.white, text_size=size.normal, bgcolor=res_col)
    table.cell(t, 2, 11, "",           text_color=color.white, text_size=size.normal, bgcolor=res_col)

// ══════════════════════════════════════════
// ALERTLER
// ══════════════════════════════════════════
alertcondition(is_period_start and decision_bull,     "5dk YUKARI",    "SOL 5dk → YUKARI")
alertcondition(is_period_start and not decision_bull, "5dk ASAGI",     "SOL 5dk → ASAGI")
alertcondition(strongBuy,                             "GUCLU AL",      "GUCLU AL Sinyali! RSI + Hacim + MACD")
alertcondition(isValidGC,                             "GOLDEN CROSS",  "Guclu Golden Cross Onaylandi!")
